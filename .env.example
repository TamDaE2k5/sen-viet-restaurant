# ==============================================================================
# HỆ THỐNG QUẢN TRỊ KHO BẾP & NHÂN SỰ SEN VIỆT BUFFET
# Cấu hình biến môi trường mẫu (.env.example)
# ==============================================================================

# 1. Cấu hình Cơ sở Dữ liệu PostgreSQL 16
DB_HOST=postgres
DB_PORT=5432
DB_NAME=senviet_db
DB_USER=senviet_user
DB_PASS=senviet_secret_pass_2026

# 2. Cấu hình Bảo mật Spring Security & JWT Token
# Chuỗi bí mật ký HMAC-SHA256 (tối thiểu 256 bits = 32 bytes hex)
JWT_SECRET=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b
# Thời hạn sống của JWT Token (milliseconds). Mặc định 24h = 86400000 ms
JWT_EXPIRATION=86400000

# 3. Cấu hình Cổng Dịch vụ (Ports)
BACKEND_PORT=8080
FRONTEND_PORT=80

# 4. Cấu hình Webhook Cảnh báo Zalo Bot (Chủ chuỗi & Kế toán khi lệch > 300k hoặc > 5%)
ZALO_WEBHOOK_URL=https://openapi.zalo.me/v2.0/oa/message
ZALO_ALERT_ENABLED=false
